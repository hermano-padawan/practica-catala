  {"id":"b2-ver-003","level":"B2","topic":"verbs","status":"reviewed","prompt":"Tria la frase correcta.","options":["Si tindria temps, hi aniria.","Si tingués temps, hi aniria.","Si tindré temps, hi aniria."],"answer":1,"explanation":"Una condició hipotètica combina imperfet de subjuntiu i condicional: tingués, aniria.","source":{"url":"https://www.cpnl.cat/gramatica/46/13-els-verbs","locator":"Imperfet de subjuntiu i condicional"},"reviewedAt":"2026-09-24","reviewedBy":"Codex; contrast CPNL"},

