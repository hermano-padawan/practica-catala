  {"id":"b2-pro-003","level":"B2","topic":"pronoms","status":"reviewed","prompt":"Substitueix «això»: «No entenc això.»","options":["No hi entenc.","No n'entenc.","No ho entenc."],"answer":2,"explanation":"Ho substitueix els demostratius neutres això i allò quan fan de complement directe.","source":{"url":"https://www.cpnl.cat/gramatica/66/37-els-pronoms-febles","locator":"Complement directe neutre"},"reviewedAt":"2026-09-24","reviewedBy":"Codex; contrast CPNL"},

